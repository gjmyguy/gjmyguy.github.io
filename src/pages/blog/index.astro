---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FolderTree from '../../components/FolderTree.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
).map((post) => ({
	...post,
	folderPath: post.id.split('/').slice(0, -1).join('/'),
}));

type FolderNode = {
	name: string;
	path: string;
	children: FolderNode[];
	posts: (typeof posts)[number][];
};

const folderTree: FolderNode[] = [];
for (const post of posts) {
	let currentLevel = folderTree;
	let currentNode: FolderNode | undefined;

	for (const name of post.folderPath.split('/')) {
		const path = currentNode ? `${currentNode.path}/${name}` : name;
		currentNode = currentLevel.find((node) => node.path === path);

		if (!currentNode) {
			currentNode = { name, path, children: [], posts: [] };
			currentLevel.push(currentNode);
		}

		currentLevel = currentNode.children;
	}

	currentNode?.posts.push(post);
}

const sortFolderTree = (nodes: FolderNode[]) => {
	nodes.sort((a, b) => a.name.localeCompare(b.name));
	nodes.forEach((node) => sortFolderTree(node.children));
};
sortFolderTree(folderTree);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	}).format(date);

// Deterministic color picker for tags
const tagColors = [
	{ bg: '#dbeafe', text: '#1d4ed8' },
	{ bg: '#dcfce7', text: '#15803d' },
	{ bg: '#fef3c7', text: '#b45309' },
	{ bg: '#f3e8ff', text: '#7e22ce' },
	{ bg: '#ffe4e6', text: '#be123c' },
	{ bg: '#ccfbf1', text: '#0f766e' },
	{ bg: '#fef9c3', text: '#a16207' },
	{ bg: '#e0e7ff', text: '#3730a3' },
];

function getTagColor(name: string): { bg: string; text: string } {
	let hash = 0;
	for (let i = 0; i < name.length; i++) {
		hash = name.charCodeAt(i) + ((hash << 5) - hash);
	}
	return tagColors[Math.abs(hash) % tagColors.length];
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			:global(body) {
				margin: 0;
				background: #eef7ff;
			}

			.blog-page {
				width: min(1100px, calc(100% - 48px));
				margin: 0 auto 88px;
			}

			.blog-layout {
				display: grid;
				grid-template-columns: 230px minmax(0, 1fr);
				gap: 20px;
				align-items: start;
			}

			.directory-nav {
				position: sticky;
				top: 84px;
				padding: 16px 12px;
				border: 1px solid #dbe3ec;
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.78);
				box-shadow: 0 8px 24px rgba(31, 41, 55, 0.08);
				backdrop-filter: blur(12px);
			}

			.directory-title {
				margin: 0 8px 10px;
				color: #6b7280;
				font-size: 11px;
				font-weight: 900;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}

			.all-filter {
				margin-bottom: 6px;
				font-weight: 900;
			}

			/* ── Post grid ────────────────────────────── */

			.post-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 10px;
			}

			.post-card {
				border-radius: 12px;
				background: rgba(255, 255, 255, 0.88);
				backdrop-filter: blur(16px);
				box-shadow: 0 18px 42px rgba(31, 41, 55, 0.12);
				transition: box-shadow 0.2s ease, transform 0.2s ease;
				overflow: hidden;
			}

			.post-card:hover {
				box-shadow: 0 4px 20px rgba(31, 41, 55, 0.15);
				transform: translateY(-2px);
			}

			.post-card-link {
				display: flex;
				align-items: center;
				gap: 12px;
				text-decoration: none;
				padding: 12px 16px;
				color: inherit;
			}

			.card-body {
				flex: 1;
				min-width: 0;
			}

			.card-top {
				display: flex;
				align-items: center;
				gap: 8px;
				margin-bottom: 6px;
			}

			.card-category {
				display: inline-block;
				padding: 2px 10px;
				border-radius: 999px;
				background: #dbeafe;
				color: #1d4ed8;
				font-size: 11px;
				font-weight: 700;
			}

			.card-title {
				margin: 0 0 4px;
				font-size: 15px;
				font-weight: 800;
				color: #111827;
				line-height: 1.4;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.post-card:hover .card-title {
				color: #0969da;
			}

			.card-desc {
				margin: 0;
				color: #6b7280;
				font-size: 13px;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 1;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.card-meta {
				flex-shrink: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 6px;
			}

			.card-date {
				color: #9ca3af;
				font-size: 12px;
				font-weight: 600;
				white-space: nowrap;
			}

			.card-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 4px;
				justify-content: flex-end;
			}

			.tag {
				padding: 2px 8px;
				border-radius: 999px;
				font-size: 11px;
				font-weight: 700;
				line-height: 1.5;
			}

			.empty-state {
				grid-column: 1 / -1;
				text-align: center;
				padding: 60px 20px;
				color: #9ca3af;
				font-size: 15px;
			}

			/* ── Mobile ────────────────────────────── */

			@media (max-width: 760px) {
				.blog-page {
					width: min(100% - 28px, 1100px);
				}

				.post-grid {
					grid-template-columns: 1fr;
				}

				.blog-layout {
					grid-template-columns: 1fr;
				}

				.directory-nav {
					position: static;
				}

				.card-title {
					font-size: 15px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<div class="blog-layout">
				<nav class="directory-nav" aria-label="文章目录">
					<p class="directory-title">Directory</p>
					<button class="tree-filter all-filter active" type="button" data-folder="all">
						<span class="tree-chevron" aria-hidden="true">›</span>
						<span>全部文章</span>
					</button>
					<FolderTree nodes={folderTree} />
				</nav>

				<div class="post-grid">
				{posts.map((post) => (
					<article class="post-card" data-folder={post.folderPath}>
						<a class="post-card-link" href={`/blog/${post.id}/`}>
							<div class="card-body">
								<div class="card-top">
									<span class="card-category">{post.folderPath.replaceAll('/', ' / ')}</span>
								</div>
								<h3 class="card-title">{post.data.title}</h3>
								<p class="card-desc">{post.data.description}</p>
							</div>
							<div class="card-meta">
								<span class="card-date">{formatDate(post.data.pubDate)}</span>
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="card-tags">
										{post.data.tags.map((tag) => {
											const color = getTagColor(tag);
											return (
												<span class="tag" style={{ background: color.bg, color: color.text }}>
													{tag}
												</span>
											);
										})}
									</div>
								)}
							</div>
						</a>
					</article>
				))}
				</div>
			</div>
		</main>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const filters = document.querySelectorAll<HTMLButtonElement>('.tree-filter');
				const cards = document.querySelectorAll<HTMLElement>('.post-card');

				filters.forEach((filter) => {
					filter.addEventListener('click', () => {
						// Update active tab
						filters.forEach((item) => item.classList.remove('active'));
						filter.classList.add('active');

						const folder = filter.dataset.folder;

						// Filter cards
						cards.forEach((card) => {
							const cardFolder = card.dataset.folder ?? '';
							if (
								folder === 'all' ||
								cardFolder === folder ||
								cardFolder.startsWith(`${folder}/`)
							) {
								card.style.display = '';
							} else {
								card.style.display = 'none';
							}
						});
					});
				});
			});
		</script>
	</body>
</html>
