---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { category?: string };

const { title, description, pubDate, updatedDate, category, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 0.5em;
				padding: 0.25em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2em;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.post-category {
				display: inline-block;
				margin-bottom: 0.8em;
				padding: 3px 12px;
				border-radius: 999px;
				background: #dbeafe;
				color: #1d4ed8;
				font-size: 13px;
				font-weight: 700;
			}
			.post-tags {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 6px;
				margin-bottom: 1em;
			}
			.post-tags .tag {
				padding: 2px 8px;
				border-radius: 999px;
				font-size: 11px;
				font-weight: 700;
				line-height: 1.5;
				background: #f3f4f6;
				color: #6b7280;
			}

			:global(body) {
				margin: 0;
				background: #f6f8fb;
				color: #374151;
			}

			.prose {
				box-sizing: border-box;
				width: min(1180px, calc(100% - 32px));
				max-width: none;
				margin: 24px auto 64px;
				padding: 28px 64px 56px;
				border: 1px solid #e5eaf0;
				border-radius: 8px;
				background: #fff;
				box-shadow: 0 12px 32px rgba(31, 41, 55, 0.06);
				font-size: 16px;
				line-height: 1.85;
			}

			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4),
			.prose :global(h5) {
				color: #111827;
				line-height: 1.4;
			}

			.prose :global(h2) {
				margin: 2.2em 0 0.7em;
				font-size: 1.55rem;
			}

			.prose :global(h2:first-child) {
				margin-top: 0.8em;
			}

			.prose :global(h3) {
				margin: 1.8em 0 0.55em;
				font-size: 1.25rem;
			}

			.prose :global(h4),
			.prose :global(h5) {
				margin: 1.4em 0 0.4em;
				font-size: 1.05rem;
			}

			.prose :global(p) {
				margin: 0.85em 0;
			}

			.prose :global(a) {
				color: #0969da;
			}

			.prose :global(ul),
			.prose :global(ol) {
				padding-left: 1.5em;
			}

			.prose :global(blockquote) {
				margin: 1.2em 0;
				border-left: 3px solid #93c5fd;
				padding: 0.2em 1em;
				background: #f8fbff;
				color: #4b5563;
			}

			.prose :global(code) {
				border-radius: 4px;
				padding: 0.15em 0.35em;
				background: #eef2f7;
				color: #334155;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.9em;
			}

			.prose :global(pre) {
				overflow-x: auto;
				margin: 1.2em 0;
				border-radius: 6px;
				padding: 16px 18px;
				background: #111827;
				color: #e5e7eb;
				line-height: 1.65;
			}

			.prose :global(pre code) {
				padding: 0;
				background: transparent;
				color: inherit;
			}

			.prose :global(table) {
				display: block;
				overflow-x: auto;
				width: 100%;
				border-collapse: collapse;
				white-space: nowrap;
			}

			.prose :global(th),
			.prose :global(td) {
				border: 1px solid #dbe3ec;
				padding: 8px 12px;
				text-align: left;
			}

			.prose :global(th) {
				background: #f3f6fa;
				color: #111827;
			}

			.prose :global(img) {
				max-width: 100%;
				height: auto;
			}

			.prose :global(hr) {
				margin: 2em 0;
				border: 0;
				border-top: 1px solid #e5eaf0;
			}

			@media (max-width: 640px) {
				.prose {
					width: calc(100% - 20px);
					margin: 20px auto 56px;
					padding: 24px 18px 40px;
					font-size: 15px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{category && <span class="post-category">{category}</span>}
						<h1>{title}</h1>
						{tags && tags.length > 0 && (
							<div class="post-tags">
								{tags.map((tag) => <span class="tag">{tag}</span>)}
							</div>
						)}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
	</body>
</html>
