---
type TreePost = {
	id: string;
	data: { title: string };
};

type FolderNode = {
	name: string;
	path: string;
	children: FolderNode[];
	posts: TreePost[];
};

interface Props {
	nodes: FolderNode[];
}

const { nodes } = Astro.props;
---

<ul class="folder-tree">
	{nodes.map((node) => (
		<li class="folder-node">
			<div class="tree-row">
				<button
					class="tree-toggle"
					type="button"
					aria-expanded="true"
					aria-controls={`folder-${node.path.replaceAll('/', '-')}`}
					aria-label={`折叠 ${node.name}`}
				>
					<span class="tree-chevron" aria-hidden="true">›</span>
				</button>
				<button class="tree-filter" type="button" data-folder={node.path}>
					<span class="folder-mark" aria-hidden="true"></span>
					<span>{node.name}</span>
				</button>
			</div>
			{(node.posts.length > 0 || node.children.length > 0) && (
				<div class="tree-children" id={`folder-${node.path.replaceAll('/', '-')}`}>
					{node.posts.map((post) => (
						<a class="file-entry" href={`/blog/${post.id}/`}>
							<span class="file-mark" aria-hidden="true"></span>
							<span>{post.data.title}</span>
						</a>
					))}
					{node.children.length > 0 && <Astro.self nodes={node.children} />}
				</div>
			)}
		</li>
	))}
</ul>

<style>
	.folder-tree {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tree-children {
		margin-left: 14px;
		padding-left: 14px;
		border-left: 1px solid #dbe3ec;
	}

	.tree-row {
		display: flex;
		align-items: center;
	}

	.tree-toggle,
	.tree-filter,
	.file-entry {
		display: flex;
		align-items: center;
		min-height: 32px;
		gap: 7px;
		border: 0;
		border-radius: 6px;
		padding: 5px 8px;
		background: transparent;
		color: #4b5563;
		font: inherit;
		font-size: 13px;
		line-height: 1.35;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.tree-toggle {
		width: 24px;
		padding: 5px 0 5px 8px;
		color: #9ca3af;
	}

	.tree-toggle:hover {
		color: #0969da;
	}

	.tree-filter {
		flex: 1;
		width: auto;
	}

	.tree-filter {
		color: #111827;
		font-weight: 800;
	}

	.file-entry {
		width: 100%;
	}

	.tree-filter:hover,
	.tree-filter.active,
	.file-entry:hover {
		background: #e8f1fb;
		color: #0969da;
	}

	.tree-chevron {
		width: 10px;
		color: #9ca3af;
		font-size: 18px;
		line-height: 1;
		transform: rotate(90deg);
		transition: transform 0.15s ease;
	}

	.folder-mark,
	.file-mark {
		position: relative;
		flex: 0 0 auto;
		width: 13px;
		height: 10px;
		border: 1.5px solid currentColor;
		border-radius: 2px;
	}

	.folder-mark::before {
		content: '';
		position: absolute;
		left: -1.5px;
		top: -4px;
		width: 6px;
		height: 4px;
		border: 1.5px solid currentColor;
		border-bottom: 0;
		border-radius: 2px 2px 0 0;
	}

	.file-mark {
		width: 11px;
		height: 13px;
		border-radius: 2px;
	}

	.file-mark::after {
		content: '';
		position: absolute;
		right: -1.5px;
		top: -1.5px;
		width: 4px;
		height: 4px;
		border-left: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		background: #fff;
	}

	@media (prefers-reduced-motion: reduce) {
		.tree-chevron {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('.tree-toggle').forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const expanded = toggle.getAttribute('aria-expanded') === 'true';
			const targetId = toggle.getAttribute('aria-controls');
			const target = targetId ? document.getElementById(targetId) : null;
			const folderName = toggle.parentElement?.querySelector('.tree-filter span:last-child')?.textContent ?? '目录';

			toggle.setAttribute('aria-expanded', String(!expanded));
			toggle.setAttribute('aria-label', `${expanded ? '展开' : '折叠'} ${folderName}`);
			if (target) target.hidden = expanded;
		});
	});
</script>
